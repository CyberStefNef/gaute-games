{
  "name": "@gaute/games-sdk",
  "version": "0.1.0",
  "description": "Make multiplayer games that Gaute groups play together, and the official Gaute games",
  "license": "MIT",
  "repository": "github:CyberStefNef/gaute-games",
  "bin": {
    "gaute-game": "tools/cli.mjs"
  },
  "files": [
    "sdk",
    "tools",
    "template",
    "simulator",
    "index.html",
    "LICENSE",
    "README.md",
    ".node-version",
    "AGENTS.md",
    "CONTRIBUTING.md"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    "./logic": "./sdk/logic.ts",
    "./client": "./sdk/client.ts",
    "./protocol": "./sdk/protocol.ts",
    "./runtime": "./sdk/runtime.ts",
    "./document": "./sdk/document.ts",
    "./react": "./sdk/react.tsx",
    "./tailwind.css": "./sdk/tailwind.css",
    "./icon": "./sdk/icon.ts"
  },
  "scripts": {
    "new": "node tools/new.mjs",
    "dev": "vp dev",
    "build": "vp build",
    "check": "vp check",
    "test": "vp test"
  },
  "devDependencies": {
    "@jitl/quickjs-singlefile-mjs-release-sync": "0.32.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "quickjs-emscripten-core": "0.32.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite-plus": "^1.5.1"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.5.1",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=24.12.0"
  },
  "packageManager": "npm@11.19.0",
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
