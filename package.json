{
  "name": "@gaute/games-sdk",
  "version": "0.1.0",
  "description": "Make multiplayer games that Gaute groups play together, and the official Gaute games",
  "license": "MIT",
  "repository": "github:CyberStefNef/gaute-games",
  "files": [
    "sdk",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./logic": "./sdk/logic.ts",
    "./client": "./sdk/client.ts",
    "./protocol": "./sdk/protocol.ts",
    "./runtime": "./sdk/runtime.ts",
    "./document": "./sdk/document.ts"
  },
  "scripts": {
    "new": "node tools/new.mjs",
    "dev": "node tools/dev.mjs",
    "build": "node tools/build.mjs",
    "check": "node tools/check.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && npm run check"
  },
  "devDependencies": {
    "@jitl/quickjs-singlefile-mjs-release-sync": "0.32.0",
    "@types/node": "^24.19.2",
    "quickjs-emscripten-core": "0.32.0",
    "typescript": "7.0.2",
    "vite-plus": "^1.5.1"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.5.1",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=24.12.0"
  },
  "packageManager": "npm@11.19.0",
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
